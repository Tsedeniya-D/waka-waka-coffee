# ---------------------------------------------------------------------------
# Waka Coffee backend configuration. Copy to .env and fill in values.
# NEVER commit .env (it is gitignored). Secrets live ONLY here, never in the
# frontend (VITE_*) environment.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API (Vite dev server etc.).
# The first origin is also used to build password-reset links.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Number of reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=0

# Supabase: Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key: used together with the caller's JWT so RLS still applies.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service_role) key. OPTIONAL. When set, employee accounts are created
# through the Supabase Auth Admin API and deactivated accounts are also banned
# in Auth. When empty, the admin_create_employee_user() database function is
# used instead (requires the 20260925* migrations). Never expose this key.
SUPABASE_SECRET_KEY=

# Storage buckets (created by migration 20260925000200_security_rls.sql)
DOCUMENTS_BUCKET=documents
PRODUCT_IMAGES_BUCKET=product-images
# Maximum document upload size in MB (bucket limit is 25 MB)
MAX_UPLOAD_MB=20

# Where password-reset emails send people (must be one of CORS_ORIGINS).
# Defaults to <first CORS origin>/admin/reset-password
PASSWORD_RESET_REDIRECT=

# ---------------------------------------------------------------------------
# Tests (npm test / npm run test:e2e). Real accounts in your Supabase project.
# ---------------------------------------------------------------------------
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
# Set RUN_E2E=1 to run tests/e2e (creates employees and business records,
# deactivates the employees afterwards).
RUN_E2E=
