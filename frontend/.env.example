# ---------------------------------------------------------------------------
# Frontend (Vite) configuration. Everything here is PUBLIC — it is bundled
# into the browser code. Never put secrets (service_role / secret keys) here.
# Copy to .env and fill in values.
# ---------------------------------------------------------------------------

# Waka Coffee API (backend/). All business data goes through it.
VITE_API_URL=http://localhost:4000/api/v1

# Supabase project URL + publishable/anon key. The browser uses Supabase only
# to keep the login session fresh and for live notification updates.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional alias accepted by the client:
# VITE_SUPABASE_PUBLISHABLE_KEY=
